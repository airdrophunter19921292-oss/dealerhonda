# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WhatsApp Session Server (optional, only if using external Baileys server)
# Set these in Supabase secrets for frontend to use
WHATSAPP_SERVER_URL=https://your-whatsapp-server.render.com
WHATSAPP_SERVER_SECRET=your-webhook-secret-here
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret-here

# WhatsApp Session Server Environment (when deploying server separately)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SESSIONS_DIR=./.sessions
